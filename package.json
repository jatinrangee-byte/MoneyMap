{
  "name": "moneymap",
  "version": "2.0.0",
  "description": "MoneyMap — Precision Personal Expense Tracker with Machine Learning. Features NLP auto-categorization, spending forecasts, anomaly detection, AI financial health scoring, and an intelligent chatbot advisor.",
  "main": "app.py",
  "scripts": {
    "start": "python3 app.py",
    "test": "python3 -m pytest test_app.py -v",
    "dev": "FLASK_ENV=development python3 app.py",
    "lint": "python3 -m flake8 app.py ml_engine.py database.py auth.py ai_chat.py"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jatinrangee-byte/MoneyMap.git"
  },
  "keywords": [
    "expense-tracker",
    "personal-finance",
    "machine-learning",
    "naive-bayes",
    "nlp",
    "anomaly-detection",
    "flask",
    "python",
    "budgeting",
    "ai-chatbot",
    "financial-health",
    "spending-forecast"
  ],
  "author": "Jatin Rangee",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jatinrangee-byte/MoneyMap/issues"
  },
  "homepage": "https://github.com/jatinrangee-byte/MoneyMap#readme",
  "engines": {
    "python": ">=3.10"
  },
  "dependencies": {
    "flask": "^3.0.0",
    "chart.js": "^4.4.1"
  },
  "devDependencies": {
    "pytest": "^8.0.0"
  },
  "python_dependencies": {
    "flask": ">=3.0.0",
    "numpy": ">=1.24.0",
    "scikit-learn": ">=1.3.0"
  },
  "project_structure": {
    "backend": [
      "app.py",
      "database.py",
      "ml_engine.py",
      "ai_chat.py",
      "auth.py"
    ],
    "frontend": [
      "templates/index.html",
      "static/css/style.css",
      "static/js/app.js"
    ],
    "ml_models": [
      "NLP Smart Categorizer (Multinomial Naive Bayes)",
      "Spending Forecaster (Linear Regression + Blended Burn Rate)",
      "Anomaly Detector (Z-Score + IQR)",
      "AI Financial Health Score (Multi-Pillar Heuristic)"
    ],
    "tests": [
      "test_app.py"
    ]
  }
}
